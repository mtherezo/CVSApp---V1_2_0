{
  "expo": {
    "name": "CVSApp",
    "slug": "CVSApp",
    "version": "3.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cvsapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mptherezo.cvsapp",
      "versionCode": 14,
      
      "androidNavigationBar": {
        "backgroundColor": "#190a32",
        "barStyle": "light-content"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_MEDIA_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA"
      ],
      "queries": [
        {
          "package": "com.whatsapp"
        },
        {
          "package": "com.whatsapp.w4b"
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      "expo-document-picker",
      "expo-font",
      "expo-image-picker",
      "expo-navigation-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c8668492-e12c-4739-a90f-54e1b5186c08"
      }
    }
  }
}
